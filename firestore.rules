rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Health check test connection
    match /test/{testId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Products collection: public read, dynamic write for real-time admin sync
    match /products/{productId} {
      allow read, write: if true;
    }

    // Categories collection: public read, dynamic write for real-time admin sync
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Orders collection: public create and read for order tracking and admin management
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Enquiries / Leads: public create, admin management
    match /enquiries/{enquiryId} {
      allow read, write: if true;
    }

    // Reviews: public read & create, admin moderation
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // FAQs collection: public read, admin write
    match /faqs/{faqId} {
      allow read, write: if true;
    }

    // CMS Pages: public read, admin write
    match /cms_pages/{pageId} {
      allow read, write: if true;
    }

    // Store settings & Homepage CMS: public read, admin write
    match /store_settings/{settingId} {
      allow read, write: if true;
    }
  }
}
