rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@hydron.com' ||
        request.auth.token.email == 'shlok5138@gmail.com' ||
        (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Health check test connection
    match /test/{testId} {
      allow read: if true;
    }

    // Users collection (PII isolation)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Products collection: public read, admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories collection: public read, admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders collection: public create, public read (for order tracking), admin update/delete
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // Enquiries / Leads: public create, admin read/write
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Reviews: public read, create, admin moderate
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // FAQs collection: public read, admin write
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // CMS Pages: public read, admin write
    match /cms_pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Store settings & Homepage CMS: public read, admin write
    match /store_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
